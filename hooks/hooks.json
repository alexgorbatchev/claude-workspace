{
  "description": "Hierarchical out-of-tree workspaces for Claude Code",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/index.js hook session-start",
            "statusMessage": "Resolving workspaces..."
          }
        ]
      }
    ]
  }
}
